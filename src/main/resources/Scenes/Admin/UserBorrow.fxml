<StackPane fx:id="userBorrowRoot" prefHeight="401.0" prefWidth="776.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.JFX_Controller.Admin.User.BorrowController">
