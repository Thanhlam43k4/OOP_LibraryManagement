<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="userBorrowRoot" prefHeight="401.0" prefWidth="776.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.JFX_Controller.Admin.User.BorrowController">
   <children>
      <Pane prefHeight="314.0" prefWidth="776.0" style="-fx-background-color: #504b4b; -fx-opacity: 0.8; -fx-background-radius: 30;" />
      <AnchorPane maxHeight="280.0" maxWidth="722.0" prefHeight="279.0" prefWidth="722.0" style="-fx-background-color: white; -fx-border-color: #8d8888; -fx-background-radius: 15; -fx-border-radius: 15;">
         <children>
            <HBox alignment="CENTER_LEFT" layoutX="34.0" layoutY="14.0" prefHeight="39.0" prefWidth="330.0" spacing="10.0">
               <children>
                  <FontAwesomeIconView fill="#403d3d" glyphName="EXCHANGE" size="25">
                     <HBox.margin>
                        <Insets top="4.0" />
                     </HBox.margin>
                  </FontAwesomeIconView>
                  <Label text="Borrow Document">
                     <font>
                        <Font name="Comic Sans MS Bold" size="28.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Button layoutX="680.0" layoutY="3.0" mnemonicParsing="false" onAction="#turnOffPane" prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: transparent;" textFill="#e4e0e0">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
               <graphic>
                  <FontAwesomeIconView glyphName="TIMES" size="27" style="-fx-fill: #3c373a;" />
               </graphic>
            </Button>
            <VBox layoutX="32.0" layoutY="59.0" prefHeight="100.0" prefWidth="658.0">
               <children>
                  <Label text="ISBN *">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>
                  <TextField fx:id="isbn" maxWidth="-Infinity" prefHeight="43.0" prefWidth="717.0" promptText="..." style="-fx-background-color: transparent; -fx-border-color: #8d8888; -fx-border-width: 1.3; -fx-border-radius: 10; -fx-text-fill: #222020; -fx-prompt-text-fill: rgb(165, 157, 157);">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </TextField>
               </children>
            </VBox>
            <Button layoutX="32.0" layoutY="180.0" mnemonicParsing="false" onAction="#borrowDoc" prefHeight="50.0" prefWidth="658.0" style="-fx-background-color: linear-gradient(to right bottom, rgb(19, 168, 57), rgb(115, 160, 12)); -fx-background-radius: 13; -fx-background-color: #262626;" text="Borrow" textFill="#f2ebeb">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
   </children>
