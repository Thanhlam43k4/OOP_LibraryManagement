<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" onMouseClicked="#showAllCopy" prefHeight="60.0" prefWidth="759.0" style="-fx-background-radius: 20;" styleClass="second-anchor-card" stylesheets="@../../CSS_Setup/card.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.JFX_Controller.Admin.DocRowController">
   <children>
      <Label fx:id="docId" alignment="CENTER" prefHeight="20.0" prefWidth="74.0" text="#123" textFill="#3c3a3a">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <Label fx:id="title" layoutX="10.0" layoutY="30.0" prefHeight="20.0" prefWidth="222.0" text="One Piece" textFill="#3c3a3a">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <padding>
            <Insets left="10.0" />
         </padding>
      </Label>
      <Label fx:id="author" layoutX="94.0" layoutY="30.0" prefHeight="20.0" prefWidth="198.0" text="Oda" textFill="#3c3a3a">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <padding>
            <Insets left="10.0" />
         </padding>
      </Label>
      <Label fx:id="genre" layoutX="10.0" layoutY="30.0" prefHeight="20.0" prefWidth="133.0" text="Manga" textFill="#3c3a3a">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <padding>
            <Insets left="10.0" />
         </padding>
      </Label>
      <Label fx:id="amount" alignment="CENTER" layoutX="474.0" layoutY="30.0" prefHeight="20.0" prefWidth="80.0" text="20" textFill="#3c3a3a">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <padding>
            <Insets left="10.0" />
         </padding>
      </Label>
      <MenuButton mnemonicParsing="false" style="-fx-border-width: 0;" styleClass="second-menubutton" stylesheets="@../../CSS_Setup/menubutton.css">
         <items>
            <MenuItem mnemonicParsing="false" onAction="#openDocModify" text="modify" />
            <MenuItem mnemonicParsing="false" onAction="#deleteDoc" text="delete" />
         </items>
         <graphic>
            <FontAwesomeIconView glyphName="ELLIPSIS_V" size="15" styleClass="fontawesome-icon" wrappingWidth="1.0" />
         </graphic>
         <padding>
            <Insets left="5.0" />
         </padding>
      </MenuButton>
   </children>
   <padding>
      <Insets right="15.0" />
   </padding>
</HBox>
